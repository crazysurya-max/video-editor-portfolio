# Added automatically when you connect Upstash Redis in Vercel (Storage/Marketplace):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (KV_REST_API_URL / KV_REST_API_TOKEN also work)
# You add these two manually:
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=random-64-char-string
BLOB_READ_WRITE_TOKEN=   # added automatically when you create a Vercel Blob store
